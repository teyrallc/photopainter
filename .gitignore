# Runtime device configuration — holds the WiFi password, admin password hash
# and session secret, so it must never be committed.
config.json

# Which iCloud shared-album photos this device has already imported. Device
# state, rebuilt on the next sync.
icloud_album.json
gdrive_imported.json

# Which photographs this device already holds, keyed by a hash of their bytes.
# Device state too — and it names the owner's files, which is nobody else's
# business. It was committed once by accident.
output/.upload-index.json
